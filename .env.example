# Server/Tauri read provider settings from the nearest .env in the working
# directory or its parents, then beside the executable if none was found.
# Process environment takes precedence. Restart the Rust host after changes.
KAIROS_JUPITER_API_KEY=
KAIROS_MARKET_RPC_URL=
# Full chat completions endpoint. HTTPS remote or HTTP loopback for local models.
KAIROS_AI_URL=
KAIROS_AI_MODEL=
KAIROS_AI_API_KEY=
KAIROS_AI_RESPONSE_FORMAT=
KAIROS_AI_REASONING_EFFORT=
KAIROS_AI_ANALYST_TIMEOUT_SECONDS=45
KAIROS_AI_STRATEGY_TIMEOUT_SECONDS=25
# LM Studio: URL=http://127.0.0.1:1234/v1/chat/completions
# MODEL must be an ID from GET /v1/models, e.g. qwen/qwen3-8b (not a website URL).
# LM Studio: RESPONSE_FORMAT=json_schema (tested with Qwen3 8B + Vulkan 2.33.0).
# text is available; empty keeps legacy json_object (unsupported by LM Studio).
# All formats still require strictly validated JSON reports/decisions in Rust.
# Optional supported reasoning effort: none, low, medium, high. Empty = provider default.
# Local Qwen: reasoning none and both timeouts 120 are a starting point.
# Both timeouts: integer 5..300 seconds (defaults: analyst 45, strategy 25).
# Restart Rust after changes.
# Open/close evidence must remain fresh within 30 seconds, regardless of timeout.
# A slower HOLD is logged with its input age and cannot create a trade proposal.
# Pump.fun discovery uses public PumpPortal creation/migration streams and DEX Screener.
# Enable and configure filters in Markets; Rust persists them in SQLite, not .env/UI state.
# No PumpPortal API key, wallet or metered trade subscriptions are used.
