# Docker Compose reads .env automatically. For npm server/Tauri, export these
# variables in the process environment before starting the Rust host.
KAIROS_JUPITER_API_KEY=
KAIROS_MARKET_RPC_URL=
# Full chat completions endpoint. HTTPS remote or HTTP loopback for local models.
KAIROS_AI_URL=
KAIROS_AI_MODEL=
KAIROS_AI_API_KEY=
